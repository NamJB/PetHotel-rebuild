<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pethotel.reservation.mapper.ResMapper">
   
   <insert id = "resSave" useGeneratedKeys="true" keyProperty="resId">
      insert into reservation
         (member_id,check_in,check_out,amount)
      values(#{memberId},#{checkIn},#{checkOut},"101")   
   </insert>
   
  <insert id = "petSave">
     insert into reservation_pet
        (res_id,pet_id)
     values
      <foreach collection = "petIds" item = "petId" separator = ",">
         (#{resId},#{petId})
      </foreach>
  </insert>
  
  <resultMap id = "resDetailMap" type = "com.pethotel.reservation.dto.ResDetailResponseDto" >
     <id property = "resId" column ="res_id"/>
     <result property  = "checkIn" column = "check_in"/>
     <result property = "checkOut" column = "check_out"/>
     <result property = "status" column = "status"/>     
     <result property = "reservationCreatedAt" column = "reservation_created_at"/>
     <result property = "reservationAmount" column = "reservation_amount"/>
     
     <result property = "nickName" column = "nickname"/>
     
     <result property = "payId" column = "pay_id"/>
     <result property = "paymentAmount" column = "payment_amount"/>
     <result property = "payMethod" column = "pay_method"/>
     <result property = "payStatus" column = "pay_status"/>
     <result property = "paidAt" column = "paid_at"/>
     
     <collection property = "pets" ofType = "com.pethotel.pet.dto.PetListResponseDto">
        <id property = "petId" column = "pet_id"/>
        <result property ="name" column = "name"/>
        <result property ="age" column = "age"/>
        <result property ="type" column = "type"/>
        <result property ="gender" column = "gender"/>
        <result property ="note" column = "note"/>
        <result property ="weight" column = "weight"/>        
     </collection>
  </resultMap>
  
  
  <select id = "resDetail" resultMap = "resDetailMap">
     select 
        r.res_id,       
        r.check_in,
        r.check_out,
        r.created_at as reservation_created_at,
        r.status,
        r.amount as reservation_amount,
              
        p.name,
        p.age,
        p.type,
        p.gender,
        p.note,
        p.weight,       
           
        m.nickname,
        
        py.pay_id,
        py.amount as payment_amount,
        py.pay_method,
        py.pay_status,
        py.paid_at
        
     from reservation r 
     
     inner join reservation_pet rp 
     on r.res_id = rp.res_id
     
     inner join pet p 
     on rp.pet_id = p.pet_id
     
     inner join member m 
     on r.member_id = m.member_id
     
     left join payment py
     on r.res_id = py.res_id
      
     where r.res_id = #{resId}
     and r.member_id =#{memberId}
  </select>
  
  <select id = "getMyReservationList" resultType = "com.pethotel.reservation.dto.ResListResponseDto">
      select                                           
         r.res_id as resId,
         r.check_in as checkIn,
         r.check_out as checkOut,
         r.status,
         r.created_at as createdAt,
         m.nickname as nickName
      from reservation r inner join member m on r.member_id = m.member_id
      where r.member_id = #{memberId}
      order by r.res_id  desc       
   </select>
  
  
   <!-- cancel,update 나중에 하나로 통일하기  -->
   <update id = "cancelReservation">
      update 
         reservation set
            status = "CANCEL"
      where res_id = #{resId}
   </update>
   
   <update id = "updatePaid">
      update
         reservation set
            status = "PAID"
      where res_id = #{resId}
   </update>
   
   <select id = "getAmount">
      select 
         amount 
      from  reservation 
      where res_id = #{resId}
   </select>
   
   <select id = "getReservationMemberId" resultType = "Integer">
      select 
         member_id
      from reservation
      where res_id =#{resId}
   </select>
   
   <select id = "getReservationInfo" resultType = "com.pethotel.reservation.dto.ReservationResponseDto">
      select 
         member_id as memberId,
         res_id as resId,
         status
      from reservation
      where res_id = #{resId}
   </select>
</mapper>